                for (var i = 0; i < result.prods.length; i++) {
                    $('#popularProductsDiv').append('<a href="' + result.prods[i].URL + '" class="w-100 f3 dib dark-gray mb2 no-underline" onclick="choosePopular(' + result.cats[i].ProductId + ')">' + result.prods[i].Name + '</a>');
