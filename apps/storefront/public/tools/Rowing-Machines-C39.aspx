            var kitSku = $('#prod_' + productID + '_kitProductSku_' + kitProductID).val();
            var kitPrice = parseFloat($('#prod_' + productID + '_kitProductAddAmount_' + kitProductID).val());
            var kitMSRP = parseFloat($('#prod_' + productID + '_kitProductAddMSRP_' + kitProductID).val());
            var kitCompareText = "";
            if ($('#prod_' + productID + '_CompareText_' + kitProductID).length > 0) {
                kitCompareText = $('#prod_' + productID + '_CompareText_' + kitProductID).html();
            }
            var kitAttributes = $('#prod_' + productID + '_Attributes_' + kitProductID).html();
            var productName = $('#prod_' + productID + '_Name').val();
            var productSku = $('#prod_' + productID + '_Sku').val();
            var productPrice = parseFloat($('#prod_' + productID + '_Price').val());
            var productMSRP = parseFloat($('#prod_' + productID + '_MSRP').val());

            var price = kitPrice + productPrice;
            var msrp = kitMSRP + productMSRP;

            $('#prod_' + productID + '_NameLink').html(productName + " with " + kitName);
            $('#prod_' + productID + '_SkuLink').html(productSku + "_" + kitSku);
            $('#prod_' + productID + '_PriceSpan').html(price.formatMoney(2, ',', '.'));
            $('#prod_' + productID + '_MSRPSpan').html(msrp.formatMoney(2, ',', '.'));
            $('#prod_' + productID + '_MSRPSpan').hide();
            if (price < msrp && msrp != 0 && productMSRP != 0) {
                $('#prod_' + productID + '_MSRPSpan').show();
            }
            $('.prod_' + productID + '_Link').attr('href', link + "?lfc=" + kitSku);

            $('#prod_' + productID + '_kitSection').html("");
            var content = "";
            if (kitCompareText !== undefined) { content += kitCompareText; }
            if (kitAttributes !== undefined) { content += kitAttributes; }
            $('#prod_' + productID + '_kitSection').html(content);
            $('#selectFromSpan_' + productID).html(kitName);

            var newImageToShow = productSku + "_" + kitSku + ".png";
            $.ajax({
                url: '/Home/ImageExistsOnServer?imageName=' + newImageToShow,
                type: 'GET',
                cache: false,
                error: function () {
                    showDefaultImage();
                },
                success: function (data) {
                    console.log(data);
                    if (data.exists) {
                        $('#prod_' + productID + '_kitImage').attr('src', 'https://www.johnsonfitness.com/Content/product_images/' + newImageToShow);
                    }
                    else {
                        $('#prod_' + productID + '_kitImage').attr('src', 'https://www.johnsonfitness.com/Content/product_images/' + productSku + '.png');
                    }
                }
            });
            $('#selectParagraph_' + productID).hide();
        }

        function renderCompare(productId) {
            $('#mainCompareDiv').html($('#prod_' + productId + '_CompareText').html());
            $("#lb-wrapper-compare-kits").fadeIn();
            $("body").addClass('overflow-hidden');
        }

        function renderAttributeInfo(productId, attributeId) {
            $('#mainCompareDiv').html($('#attributeExtra_' + productId + '_' + attributeId).html());
            $("#lb-wrapper-compare-kits").fadeIn();
            $("body").addClass('overflow-hidden');
        }
		$('a.pdp-link').hover(function(){
		  $(this).closest('.product').addClass('hovered');
		  }, function(){
		  $(this).closest('.product').removeClass('hovered');
        });

        function addItemToQuote(productId, sku) {
	        var name = "Add to Quote from Listing";
            analytics.track(name, { product_ID: sku, quantity: 1 });		
	        var url = 'https://www.johnsonfitness.com/Home/Cart?action=add&product_id=' + productId + '&CQ=1';
    
            var openCartModal = "&openCartModal=1";
            console.log("Cart URL: " + url);
	        document.getElementById('MASTER_CartFrameSubmission').src = url + openCartModal;
            $('.quote-count').show();
            $('.quote-count-wrap').show();
        }
	</script>

