    function performSearchSuggestions() {
        var search = $('#search_bar').val();
        var cat = $('#searchCategoryOption').val();
        if (search.length > 2) {
            // perform a suggestion
            $('.popularSearches').addClass('not-active');
            $.ajax({
                type: "POST",
                url: "/Home/SearchSuggestions",
                data: { search: search, cat: cat },
                success: function (res) {
                    //console.log(res);
                    $('#popularSuggestionsResults').empty();
                    if (res.length > 0) {
                        $('#popularSuggestions').removeClass('not-active');
                        for (var i = 0; i < res.length; i++) {
                            $('#popularSuggestionsResults').append('<a href="' + res[i].URL + '" class="w-100 f3 dib moon-gray mb2 no-underline" onclick="logSearch();">' + res[i].Name + '</a>');
                        }
                    }
                    else {
                        $('#popularSuggestions').addClass('not-active');
                    }
                }
            });
        }
        else {
            $('#popularSuggestions').addClass('not-active');
            $('.popularSearches').removeClass('not-active');
        }
    }

    function openChatWindow() {
        if(!chatIframeHasData) {
            document.getElementById('chatIframe').src = 'https://chat.leisurefitness.com:8443/webchat/userinfo.jsp?workgroup=sales@workgroup.chat.leisurefitness.com';
            chatIframeHasData = true;
        }
        $('.slider_chat').toggleClass('hide');
        $('.chat_window').slideToggle();

        chatOpen = !chatOpen;

        if (chatBlinkInterval) {
            clearInterval(chatBlinkInterval);
            chatBlinkInterval = null;
        }

        $('#closeChatWindowButton').removeClass('blinkOn');  // just in case, we should remove our grey class when user clicks
        $('#openChatWindowButton').removeClass('blinkOn');
    }

