    function switchToPage(newPageIndex) {
        currentPageIndex = newPageIndex;
        showActivePage();
    }

    function nextPage(indexAmount){
        currentPageIndex += indexAmount;
        if(currentPageIndex < 1) currentPageIndex = 1;
        if(currentPageIndex > numPages) currentPageIndex = numPages;

        showActivePage();
    }

    function hideAllPages(){
        for(var i = 1; i <= numPages; i++){
            document.getElementById('pageIndex_' + i).style.display = 'none';
            document.getElementById('pageLink_' + i).className = '';
        }
    }

    function showActivePage(){
        hideAllPages();
        document.getElementById('pageIndex_' + currentPageIndex).style.display = '';
        document.getElementById('pageLink_' + currentPageIndex).className = 'active';

        // calculate new index amounts
        var startIndex = (currentPageIndex - 1) * numItemsPerPage;
        var endIndex = startIndex + numItemsPerPage;
        if(startIndex < 1) startIndex = 1;
        if(endIndex > totalItemsOnSheet) endIndex = totalItemsOnSheet;
        document.getElementById('startIndexSpan').innerHTML = startIndex;
        document.getElementById('endIndexSpan').innerHTML = endIndex;

        window.location.hash = "#top_nav";
        window.scrollBy(0,200);
    }
		
