	function sortMethodChanged(newMethod) {
        var currentParams = window.location.search.substring(1);
        if (currentParams == "" || currentParams == null) {
            currentParams = "?";
        }
        window.location = window.location.href.split('?')[0] + "?" + currentParams + '&sort=' + newMethod;
