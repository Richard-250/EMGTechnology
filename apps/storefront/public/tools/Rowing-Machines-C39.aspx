                            }
                        }
                        else if (elementName == 'filter_PROMO') {
                            if (productObject.attr('data-PROMO') == '1') {
                                productMatchesLabel = true;
                            }
                        }
                        else {
                            if (productObject.attr('data-' + element) == id) {
                                productMatchesLabel = true;
                            }
                        }

                        if (productObject.attr('data-shown') == '1') {
                            // element shown so we care about it
                            if (productMatchesLabel) {
                                productsInCheckbox++;
