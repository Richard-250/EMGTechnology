    var dataBase = new Lawnchair('chatLogger', function () {
        // this happens after the db is up
        this.each(function (record, index) {
            if (record.type == 'chatStarted') {
                chatHasStarted = true;
                //alert("Chat session was started:" + record.hasStarted + "|" + record.startDate);
                return;
            }
        });
    });

    function chatPostedHookEvent(yakWin, from, text, email) {
        if (loadingOldChats) return;
        if (from == "") return; // don't log announcements
        
        //console.log("MASTERChat: " + from + "|" + text);
        var dateString = printDateTime(new Date());
        dataBase.save({ type: 'chatHit', from: from, text: text, date: dateString });
        
        if (!chatHasStarted) {
            dataBase.save({ type: 'chatStarted', hasStarted: true, startDate: printDateTime(new Date()) });
            chatHasStarted = true;
        }

        if (!chatOpen) {
            if (!chatBlinkInterval) {
                chatBlinkInterval = setInterval(function() { $('.blinkOff').toggleClass('blinkOn'); }, 500);
            }
        }
        else {
            if (chatBlinkInterval) {
                clearInterval(chatBlinkInterval);
                chatBlinkInterval = null;
            }
        }

        $.ajax({
            url: "https://portal.leisurefitness.com/WebServices/RecordChat/WebServices/RecordChat",
            type: "POST",
            data: { chatID: savedChatID, from: from, text: text, email: email },
            success: function(){
            }
        })
    }

    function addTextToIframe(from, text) {
        var ifrm = document.getElementById('chatIframe');
        ifrm = (ifrm.contentWindow) ? ifrm.contentWindow : (ifrm.contentDocument.document) ? ifrm.contentDocument.document : ifrm.contentDocument;
        ifrm.addChatText(ifrm.window.frames['yak'], from, text);
    }

    function sendRealChatMessage(chatID, text) {
        var ifrm = document.getElementById('chatIframe');
        ifrm = (ifrm.contentWindow) ? ifrm.contentWindow : (ifrm.contentDocument.document) ? ifrm.contentDocument.document : ifrm.contentDocument;
        ifrm.room.sendMessage(null, chatID, text);
    }
    
    function scrollToEndIframe() {
        var ifrm = document.getElementById('chatIframe');
        ifrm = (ifrm.contentWindow) ? ifrm.contentWindow : (ifrm.contentDocument.document) ? ifrm.contentDocument.document : ifrm.contentDocument;
        ifrm.scrollYakToEnd(ifrm.window.frames['yak']);
    }

    function simulateChatContent() {
        if (chatSimulatorOn) {
            chatPostedHookEvent('', 'Test', 'Some Text');
            setTimeout(function() { simulateChatContent(); }, 10000);
        }
    }
    
    function clearSavedChats() {
        dataBase.nuke();
    }
    
    function stopChatSimulator() {
        chatSimulatorOn = false;
    }

    function chatFrameLoaded(chatID) {
        var hasChatRecords = false;
        savedChatID = chatID;
        loadingOldChats = true;

        sendRealChatMessage(chatID, 'User is viewing page: ' + document.URL);

        dataBase.each(function (record, index) {
            if (record.type == 'chatHit') {
                addTextToIframe(record.from, record.text);
                hasChatRecords = true;
                return;
            }
        });
        
        //console.log("Saving chatID:" + chatID);
        dataBase.save({ key: 'chatID', type: 'chatID', savedChatID: chatID });

        if (hasChatRecords) {
            scrollToEndIframe();
            if (chatHasStarted && !chatOpen) {
                openChatWindow();
            }
        }
        loadingOldChats = false;
    }
    
    function resetChatFrame() {
        document.getElementById('chatIframe').src = 'https://chat.leisurefitness.com:8443/webchat/userinfo.jsp?workgroup=sales@workgroup.chat.leisurefitness.com';
        chatIframeHasData = true;
        dataBase.save({ key: 'chatID', type: 'chatID', savedChatID: "" }); // reset to blank if we cannot nuke...
        dataBase.nuke();
    }
	

