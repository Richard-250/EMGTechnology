                for (var i = 0; i < result.cats.length; i++) {
                    $('#popularCategoriesDiv').append('<a href="' + result.cats[i].URL + '" class="w-100 f3 dib dark-gray mb2 no-underline" onclick="choosePopular(' + result.cats[i].ProductId + ')">' + result.cats[i].Name + '</a>');
