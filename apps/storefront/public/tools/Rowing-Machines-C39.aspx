        function recompileCountsForElement(elementName) {
            if ($('.' + elementName).length > 0) {
                $('.' + elementName).each(function (index, value) {
                    var obj = $(value);
                    var id = obj.attr('data-id');
                    var element = obj.attr('data-element');
                    var isChecked = obj.is(":checked");
                    var productsInCheckbox = 0;
                    $("#productGrid > div[data-product='1']").each(function (i, val) {
                        var productObject = $(val);
                        var productMatchesLabel = false;

                        if (elementName == 'filter_keyword') {
                            var words = productObject.attr('data-' + element);
                            if (words.indexOf(id + ",") > -1) {
                                productMatchesLabel = true;
                            }
                        }
                        else if (elementName == 'filter_attr') {
                            var attrs = productObject.attr('data-attributes');
                            if (attrs.indexOf(id + ",") > -1) {
                                productMatchesLabel = true;
                            }
                        }
                        else if (elementName == "filter_stockDisplay") {
                            // include both display and in-stock
                            if (productObject.attr('data-' + element) == id) {
                                productMatchesLabel = true;
                            }
                            else if (productObject.attr('data-stockInStock') == id) {
                                productMatchesLabel = true;
