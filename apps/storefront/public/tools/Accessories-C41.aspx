                }

                $('.email-offer').addClass('dn');
                $('.email-confirmation').removeClass('dn');
				
                grecaptcha.ready(function () {
                    grecaptcha.execute('6LeU9pYUAAAAAP8JVivOVP6EsUkRVxFeixw4_PA_', { action: 'submit' }).then(function (token) {
                        // Add your logic to submit to your backend server here.
						$('#newsletter-g-recaptcha-response').val(token);
						analytics.track('Form Submit - Newsletter Offer', $('#newsletterForm').serializeObject());
                        $.ajax({
                            url: "/LFE/WebForms?formName=BFSF_Newsletter",
                            method: "POST",
                            data: $('#newsletterForm').serializeObject(),
                            success: function (res) {
                                console.log(res);
                                createCookie("lfeNewsletterOpened", "yes", 365);
                                $('.autonewsletter-btn').addClass('dn');
                                eraseCookie("lfeNewsletterClosed");
								beefyJsIdentify(document.getElementById('nl-email').value, "Residential");
                            }
                        });
                    });
                });
            }
        });
    }
