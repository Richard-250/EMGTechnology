    function performSearchSuggestions() {
        var search = $('#search_bar').val();
        var cat = $('#searchCategoryOption').val();
        if (search.length > 2) {
            // perform a suggestion
            $('.popularSearches').addClass('not-active');
            $.ajax({
                type: "POST",
                url: "/Home/SearchSuggestions",
                data: { search: search, cat: cat },
                success: function (res) {
                    //console.log(res);
                    $('#popularSuggestionsResults').empty();
                    if (res.length > 0) {
                        $('#popularSuggestions').removeClass('not-active');
                        for (var i = 0; i < res.length; i++) {
                            $('#popularSuggestionsResults').append('<a href="' + res[i].URL + '" class="w-100 f3 dib moon-gray mb2 no-underline" onclick="logSearch();">' + res[i].Name + '</a>');
                        }
                    }
                    else {
                        $('#popularSuggestions').addClass('not-active');
                    }
                }
            });
        }
        else {
            $('#popularSuggestions').addClass('not-active');
            $('.popularSearches').removeClass('not-active');
        }
    }

    function openChatWindow() {
        if(!chatIframeHasData) {
            document.getElementById('chatIframe').src = 'https://chat.leisurefitness.com:8443/webchat/userinfo.jsp?workgroup=sales@workgroup.chat.leisurefitness.com';
            chatIframeHasData = true;
        }
        $('.slider_chat').toggleClass('hide');
        $('.chat_window').slideToggle();

        chatOpen = !chatOpen;

        if (chatBlinkInterval) {
            clearInterval(chatBlinkInterval);
            chatBlinkInterval = null;
        }

        $('#closeChatWindowButton').removeClass('blinkOn');  // just in case, we should remove our grey class when user clicks
        $('#openChatWindowButton').removeClass('blinkOn');
    }

    function togglePopular() {
        var cat = $('#searchCategoryOption').val();
        console.log("Toggle Popular: " + cat);
        $.ajax({
            url: "/Home/GetPopularItems",
            type: "POST",
            data: { type: cat },
            success: function (result) {
                performSearchSuggestions();
                $('#popularProductsDiv').empty();
                $('#popularCategoriesDiv').empty();

                for (var i = 0; i < result.cats.length; i++) {
                    $('#popularCategoriesDiv').append('<a href="' + result.cats[i].URL + '" class="w-100 f3 dib dark-gray mb2 no-underline" onclick="choosePopular(' + result.cats[i].ProductId + ')">' + result.cats[i].Name + '</a>');
                }

                for (var i = 0; i < result.prods.length; i++) {
                    $('#popularProductsDiv').append('<a href="' + result.prods[i].URL + '" class="w-100 f3 dib dark-gray mb2 no-underline" onclick="choosePopular(' + result.cats[i].ProductId + ')">' + result.prods[i].Name + '</a>');
                }
            }
        });
    }

    function performSearch() {
        if (trim(document.getElementById("search_bar").value) == "") {
            alert("Please enter a search field.");
            return;
        }
        
        grecaptcha.ready(function () {
            grecaptcha.execute('6LeU9pYUAAAAAP8JVivOVP6EsUkRVxFeixw4_PA_', { action: 'submit' }).then(function (token) {
                // Add your logic to submit to your backend server here.
                //$('#searchToken').val(token);
                logSearch();
                document.getElementById('searchFrm').submit();
            });
        });
        
    }

    function logSearch() {
        if (gtag) {
            gtag("event", "search", {
                search_term: document.getElementById("search_bar").value
            });
        }

