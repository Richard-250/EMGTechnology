        function catLfCreateSelectItem(productID, kitProductID) {
            $('.prod_' + productID + '_kitImageLink').removeClass('active');
            $('#prod_' + productID + '_kitImageLink_' + kitProductID).addClass('active');
            var link = $('#prod_' + productID + '_OriginalLink').val();
