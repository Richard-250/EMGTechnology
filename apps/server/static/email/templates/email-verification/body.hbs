{{> header title="Verify your email" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text color="#525252" font-size="15px" line-height="24px">
            Thank you for creating an EMG Technology account. Click the button below to verify this
            email address and complete registration:
        </mj-text>

        <mj-button font-family="Helvetica"
                   background-color="#269A2D"
                   color="white"
                   href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}">
            Verify my email
        </mj-button>
    </mj-column>
</mj-section>

{{> footer }}
