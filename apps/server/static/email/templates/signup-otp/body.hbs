{{> header title="Verify your email" }}

<mj-section padding="8px 24px 0">
    <mj-column>
        <mj-text font-size="15px" color="#374151">
            Dear {{ firstName }},
        </mj-text>
        <mj-text font-size="15px" color="#374151">
            Please use the verification code below to continue creating your EMG Technology account.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section padding="16px 24px">
    <mj-column css-class="summary-box" padding="20px">
        <mj-text css-class="summary-title" padding-bottom="12px">
            Your Verification Code
        </mj-text>
        <mj-text align="center" font-size="36px" font-weight="700" color="#269A2D" letter-spacing="10px" padding="16px 0">
            {{ otp }}
        </mj-text>
        <mj-divider border-color="#e5e7eb" border-style="dashed" />
        <mj-text css-class="summary-hint" padding-top="12px">
            This code expires in 10 minutes. Enter it on the registration page to verify your email address.
        </mj-text>
        <mj-text css-class="summary-hint" padding-top="4px">
            If you did not request this code, you can safely ignore this email.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
