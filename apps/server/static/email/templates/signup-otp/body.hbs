{{> header title="Your EMG OTP verification code" }}

<mj-section padding="8px 20px 0" background-color="#f4f6f8">
    <mj-column css-class="email-card" padding="28px 24px">
        <mj-text font-size="22px" font-weight="700" color="#111827" align="center" padding-bottom="8px">
            Verify your email
        </mj-text>
        <mj-text font-size="15px" color="#4b5563" align="center" padding-bottom="4px">
            Hi {{ firstName }},
        </mj-text>
        <mj-text font-size="15px" color="#4b5563" align="center">
            Enter this one-time password (OTP) on the registration page to verify your email and continue creating your account.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section padding="16px 20px" background-color="#f4f6f8">
    <mj-column css-class="otp-box" padding="28px 16px">
        <mj-text css-class="summary-title" align="center" padding-bottom="8px">
            Your OTP code
        </mj-text>
        <mj-text align="center" font-size="36px" font-weight="700" color="#16601a" letter-spacing="14px" padding="12px 8px 20px">
            {{ otp }}
        </mj-text>
        <mj-text css-class="summary-hint" align="center">
            This OTP expires in <strong>10 minutes</strong>. Do not share it with anyone.
        </mj-text>
        <mj-text css-class="summary-hint" align="center" padding-top="8px">
            If you did not request this code, you can safely ignore this email.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
