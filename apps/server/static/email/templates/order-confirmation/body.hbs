{{> header title="Payment confirmed" }}

<mj-section padding="8px 24px 0">
    <mj-column>
        <mj-text font-size="15px" color="#374151">
            Dear {{ order.customer.firstName }},
        </mj-text>
        <mj-text font-size="15px" color="#374151">
            Great news — your payment for order <strong>#{{ order.code }}</strong> has been verified
            and confirmed. Your order has been received and will be prepared as requested.
            Please find your invoice summary below, and download the attached PDF for your records.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section padding="16px 24px">
    <mj-column css-class="summary-box" padding="20px">
        <mj-text css-class="summary-title" padding-bottom="16px">
            Your Order Summary
        </mj-text>

        <mj-table css-class="summary-row">
            <tr>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;">Order Code</td>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ order.code }}</td>
            </tr>
            <tr>
                <td colspan="2" style="font-size:12px;color:#6b7280;padding-bottom:8px;">Reference for tracking and support</td>
            </tr>
        </mj-table>

        <mj-table css-class="summary-row">
            <tr>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;">Order Date</td>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ formatDate order.orderPlacedAt }}</td>
            </tr>
            <tr>
                <td colspan="2" style="font-size:12px;color:#6b7280;padding-bottom:8px;">When your order was placed</td>
            </tr>
        </mj-table>

        <mj-table css-class="summary-row">
            <tr>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;">Subtotal</td>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ formatMoney order.subTotalWithTax order.currencyCode 'en' }}</td>
            </tr>
        </mj-table>

        {{#if order.shippingWithTax}}
        <mj-table css-class="summary-row">
            <tr>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;">Shipping</td>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ formatMoney order.shippingWithTax order.currencyCode 'en' }}</td>
            </tr>
        </mj-table>
        {{/if}}

        <mj-divider border-color="#e5e7eb" border-style="dashed" padding="12px 0" />

        <mj-table>
            <tr>
                <td style="padding:8px 0;font-size:16px;font-weight:700;color:#111827;">Total Paid</td>
                <td style="padding:8px 0;font-size:16px;font-weight:700;color:#269A2D;text-align:right;">{{ formatMoney order.totalWithTax order.currencyCode 'en' }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

<mj-section padding="0 24px 16px">
    <mj-column css-class="summary-box" padding="20px">
        <mj-text css-class="summary-title" padding-bottom="12px">Items Ordered</mj-text>
        <mj-table>
            {{#each order.lines}}
            <tr style="border-bottom:1px dashed #e5e7eb;">
                <td style="padding:10px 0;font-size:14px;color:#374151;">{{ quantity }}× {{ productVariant.name }}</td>
                <td style="padding:10px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ formatMoney linePriceWithTax ../order.currencyCode 'en' }}</td>
            </tr>
            {{/each}}
        </mj-table>
    </mj-column>
</mj-section>

{{#if order.shippingAddress}}
<mj-section padding="0 24px 16px">
    <mj-column css-class="summary-box" padding="20px">
        <mj-text css-class="summary-title" padding-bottom="8px">Delivery Address</mj-text>
        <mj-text font-size="14px" color="#374151" line-height="22px">
            {{#with order.shippingAddress}}
            {{ fullName }}<br/>
            {{#if streetLine1}}{{ streetLine1 }}<br/>{{/if}}
            {{#if city}}{{ city }}{{/if}}{{#if postalCode}}, {{ postalCode }}{{/if}}<br/>
            {{#if country}}{{ country }}{{/if}}
            {{/with}}
        </mj-text>
    </mj-column>
</mj-section>
{{/if}}

<mj-section padding="0 24px 8px">
    <mj-column>
        <mj-button href="{{ storefrontUrl }}/account/orders" background-color="#269A2D" color="#ffffff" border-radius="10px" font-weight="600">
            View your orders
        </mj-button>
        <mj-text font-size="13px" color="#6b7280" align="center" padding-top="8px">
            Your PDF invoice is attached to this email.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section padding="8px 24px 0">
    <mj-column>
        <mj-text font-size="14px" color="#374151">
            If you have any questions, feel free to reach out to our support team.
        </mj-text>
        <mj-text font-size="14px" color="#111827" font-weight="600">
            The EMG Technology Team
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
