{{> header title="New order — payment proof" }}

<mj-section padding="8px 24px 0">
    <mj-column>
        <mj-text font-size="18px" font-weight="700" color="#0C1210">
            New customer order awaiting payment confirmation
        </mj-text>
        <mj-text font-size="14px" color="#4A5550">
        A customer completed checkout and submitted a payment screenshot. Please verify the proof below, then confirm the payment in the admin dashboard.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section padding="16px 24px">
    <mj-column css-class="summary-box" padding="20px">
        <mj-text css-class="summary-title" padding-bottom="12px">Order summary</mj-text>
        <mj-table>
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Order</td>
                <td style="padding:6px 0;font-size:14px;font-weight:700;color:#111827;text-align:right;">#{{ order.code }}</td>
            </tr>
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Customer</td>
                <td style="padding:6px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ order.customer.firstName }} {{ order.customer.lastName }}</td>
            </tr>
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Email</td>
                <td style="padding:6px 0;font-size:14px;color:#111827;text-align:right;">{{ order.customer.emailAddress }}</td>
            </tr>
            {{#if order.customer.phoneNumber}}
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Phone</td>
                <td style="padding:6px 0;font-size:14px;color:#111827;text-align:right;">{{ order.customer.phoneNumber }}</td>
            </tr>
            {{/if}}
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Total</td>
                <td style="padding:6px 0;font-size:16px;font-weight:700;color:#269A2D;text-align:right;">{{ formatMoney order.totalWithTax order.currencyCode 'en' }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

<mj-section padding="0 24px 16px">
    <mj-column css-class="summary-box" padding="20px">
        <mj-text css-class="summary-title" padding-bottom="12px">Payment proof</mj-text>
        <mj-table>
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Method</td>
                <td style="padding:6px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{#if paymentProof.mobileMoneyProvider}}{{ paymentProof.mobileMoneyProvider }}{{else}}{{ paymentProof.method }}{{/if}}</td>
            </tr>
            {{#if paymentProof.payerAccountName}}
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Payer name</td>
                <td style="padding:6px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ paymentProof.payerAccountName }}</td>
            </tr>
            {{/if}}
            {{#if paymentProof.mobileMoneyPhone}}
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Payer phone</td>
                <td style="padding:6px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ paymentProof.mobileMoneyPhone }}</td>
            </tr>
            {{/if}}
            {{#if paymentProof.transactionId}}
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Transaction ID</td>
                <td style="padding:6px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ paymentProof.transactionId }}</td>
            </tr>
            {{/if}}
            {{#if paymentProof.paymentReference}}
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Reference</td>
                <td style="padding:6px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ paymentProof.paymentReference }}</td>
            </tr>
            {{/if}}
            <tr>
                <td style="padding:6px 0;font-size:14px;color:#6b7280;">Status</td>
                <td style="padding:6px 0;font-size:14px;font-weight:700;color:#b45309;text-align:right;">Awaiting confirmation</td>
            </tr>
        </mj-table>
        {{#if paymentProof.paymentProofUrl}}
        <mj-text font-size="14px" font-weight="600" color="#0C1210" padding-top="12px" padding-bottom="8px">
            Payment screenshot
        </mj-text>
        <mj-image src="{{ paymentProof.paymentProofUrl }}" alt="Payment proof screenshot" width="320px" border-radius="8px" />
        <mj-text font-size="12px" color="#6b7280" padding-top="6px">
            <a href="{{ paymentProof.paymentProofUrl }}" style="color:#269A2D;">Open full screenshot</a>
        </mj-text>
        {{/if}}
    </mj-column>
</mj-section>

<mj-section padding="0 24px 16px">
    <mj-column css-class="summary-box" padding="20px">
        <mj-text css-class="summary-title" padding-bottom="8px">Items</mj-text>
        <mj-table>
            {{#each order.lines}}
            <tr style="border-bottom:1px dashed #e5e7eb;">
                <td style="padding:8px 0;font-size:14px;color:#374151;">{{ quantity }}× {{ productVariant.name }}</td>
                <td style="padding:8px 0;font-size:14px;font-weight:600;color:#111827;text-align:right;">{{ formatMoney linePriceWithTax ../order.currencyCode 'en' }}</td>
            </tr>
            {{/each}}
        </mj-table>
        {{#if order.customFields.deliveryDate}}
        <mj-text font-size="13px" color="#4A5550" padding-top="10px">
            Scheduled delivery: <strong>{{ order.customFields.deliveryDate }}</strong>
        </mj-text>
        {{/if}}
    </mj-column>
</mj-section>

<mj-section padding="0 24px 8px">
    <mj-column>
        <mj-button href="{{ dashboardUrl }}" background-color="#269A2D" color="#ffffff" border-radius="10px" font-weight="600">
            Review &amp; confirm payment
        </mj-button>
    </mj-column>
</mj-section>

{{> footer }}
