<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
        <mj-attributes>
            <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
            <mj-text font-size="15px" line-height="24px" color="#374151" />
            <mj-button background-color="#269A2D" color="#ffffff" font-size="15px" font-weight="600" border-radius="10px" inner-padding="14px 28px" />
        </mj-attributes>
        <mj-style inline="inline">
            .email-card { border: 1px solid #e8ecf0; border-radius: 16px; background: #ffffff; }
            .otp-box { background: #f3faf4; border: 1px solid #cde9d0; border-radius: 14px; }
            .otp-digit { display: inline-block; width: 42px; height: 52px; line-height: 52px; margin: 0 4px; border-radius: 10px; border: 1.5px solid #269A2D; background: #ffffff; color: #16601a; font-size: 26px; font-weight: 700; text-align: center; letter-spacing: 0; }
            .summary-title { font-size: 16px; font-weight: 700; color: #111827; }
            .summary-hint { font-size: 13px; color: #6b7280; line-height: 20px; }
            .brand-link { color: #269A2D; text-decoration: none; font-weight: 600; }
        </mj-style>
    </mj-head>
    <mj-body background-color="#f4f6f8">
        <mj-section padding="28px 20px 12px" background-color="#f4f6f8">
            <mj-column>
                <mj-image
                    src="https://emgtechnologyltd.com/images/logo.png"
                    alt="EMG Technology Ltd"
                    width="180px"
                    align="center"
                    padding="0"
                />
            </mj-column>
        </mj-section>
