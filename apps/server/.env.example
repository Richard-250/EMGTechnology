APP_ENV=dev
PORT=3001
COOKIE_SECRET=change-me-to-a-random-string
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=emg_admin
DB_PASSWORD=emg_dev_password
DB_NAME=emgtechnology
DB_SYNCHRONIZE=true
# Optional: Vite dev server port for dashboard UI development (default 51799 = disabled proxy on :3001)
# DASHBOARD_VITE_PORT=51799

# Google Identity Services (GIS) — ID token verification on the server
# Use the same Web Client ID in GOOGLE_CLIENT_ID and storefront NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# Server-side only — NOT required for GIS button + ID token flow; never expose in frontend
GOOGLE_CLIENT_SECRET=

# Production storefront URL (used in email links and asset URLs)
# STOREFRONT_URL=https://emgtechnologyltd.com

# Google Cloud Console (Web application OAuth client):
# Authorized JavaScript origins:
#   https://emgtechnologyltd.com
#   http://localhost:3002
# Authorized redirect URIs (GIS "Continue with Google" button — credential flow):
#   https://emgtechnologyltd.com
#   http://localhost:3002
# No server callback route is required; the browser receives a Google ID token and the
# storefront sends it to Vendure shop-api authenticate(input: { google: { token } }).

# Gmail SMTP — used to send signup verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
STOREFRONT_URL=http://localhost:3002
# Must match REVALIDATION_SECRET in apps/storefront/.env — triggers cache refresh when admin updates products/prices
REVALIDATION_SECRET=your-secure-random-string-here

# Cloudinary — image CDN (paste-URL asset import stores files here; DB keeps link + metadata only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder for product images (default: emg-products)
# CLOUDINARY_FOLDER=emg-products

PGUSER=postgres
PGPASSWORD=your-postgres-password
